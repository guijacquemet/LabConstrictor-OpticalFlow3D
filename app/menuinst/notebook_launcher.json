{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-3.schema.json",
  "menu_name": "OpticalFlow3D Profiler",
  "menu_items": [
    {
      "name": "OpticalFlow3D Profiler",
      "description": "Launch OpticalFlow3D Profiler in its packaged JupyterLab environment.",
      "activate": true,
      "terminal": true,
      "working_dir": "{{ HOME }}",
      "command": [
        "{{ PYTHON }}",
        "{{ PREFIX }}/OpticalFlow3D Profiler/launch_jupyter.py",
        "{{ PREFIX }}/OpticalFlow3D Profiler/notebooks/Welcome.ipynb"
      ],
      "platforms": {
        "win": {
          "icon": "BASE_PATH_KEYWORD/OpticalFlow3D Profiler/opticalflow3d_profiler_icon.ico",
          "command": [
            "{{ PYTHON }}",
            "{{ PREFIX }}/OpticalFlow3D Profiler/launch_jupyter.py",
            "{{ PREFIX }}/OpticalFlow3D Profiler/notebooks/Welcome.ipynb",
            "&",
            "exit"
          ]
        },
        "linux": {
          "icon": "BASE_PATH_KEYWORD/OpticalFlow3D Profiler/opticalflow3d_profiler_icon.png"
        },
        "osx": {
          "icon": "BASE_PATH_KEYWORD/OpticalFlow3D Profiler/opticalflow3d_profiler_icon.icns"
        }
      }
    }
  ]
}
